---
import Base from '../layouts/Base.astro';
import data from '../data/referrals.json';
import videos from '../data/videos.json';
---
<Base title="AI Training Jobs | Get Paid to Train AI" description="Find remote AI training jobs, data annotation work, and AI instruction opportunities from Mercor, Outlier, Data Annotation, Scale, Telus, and more.">
  <section class="hero">
    <h1>{data.headline}</h1>
  </section>
  <section>
    <h2>{data.heading}</h2>
    <p class="disclosure">{data.description}</p>
    <ul class="grid">
      {data.entries.map((e) => (
        <li class="card">
          <h3>{e.company}</h3>
          {e.note && <p class="exp">{e.note}</p>}
          {e.experience && <p class="exp">{e.experience}</p>}
          <a class="btn" href={e.url} target="_blank" rel="noopener sponsored">Apply &rarr;</a>
        </li>
      ))}
    </ul>
  </section>
  <section>
    <h2>Videos</h2>
    <div class="videos">
      {videos.map((v) => (
        <iframe src={`https://www.youtube-nocookie.com/embed/${v.id}`} title={v.title} loading="lazy" allowfullscreen></iframe>
      ))}
    </div>
  </section>
</Base>